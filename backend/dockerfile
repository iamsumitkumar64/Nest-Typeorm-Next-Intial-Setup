ARG NODE_IMAGE=node:24.15.0-alpine
ARG PORT=8080






# Stage 1: Base runtime
FROM ${NODE_IMAGE} AS base

WORKDIR /app

# Copy package files first for dependency caching
COPY package.json package-lock.json ./

# Install all dependencies including devDependencies (needed for TypeScript compilation)
RUN npm ci

# Copy source code and configuration
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src/ ./src/

# Expose the application port
EXPOSE ${PORT}







# Stage 2: build runtime (only for production builds)
FROM base AS builder

# Build the NestJS application
RUN npm run build







# Stage 3: dev runtime
FROM base AS dev

# Start the application
CMD ["npm", "run", "start:dev"]








# Stage 4: Production runtime
FROM ${NODE_IMAGE} AS production

WORKDIR /app

# Create a non-root user and set working directory ownership
RUN addgroup -S myGroup && adduser -S myUser -G myGroup && chown -R myUser:myGroup /app

# Copy package files with --chown
COPY --chown=myUser:myGroup package.json package-lock.json ./

# Switch to non-root user before clean install
USER myUser

# Clean install production dependencies
RUN npm ci --omit=dev

# Copy compiled build output from builder with --from=builder --chown
COPY --from=builder --chown=myUser:myGroup /app/dist ./dist

# Expose the application port
EXPOSE ${PORT}

# Set production environment
ENV NODE_ENV=production

# Start the application
CMD ["node", "dist/main.js"]